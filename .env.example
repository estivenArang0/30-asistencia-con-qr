# Copia este archivo a .env.local y completa los valores.
# .env.local NUNCA se versiona (ver .gitignore).

# --- Configuración web de Firebase (pública por diseño) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Solo servidor (Admin SDK y secretos propios) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
QR_SECRET=

# --- Solo desarrollo (login falso dev.<uid>.<rol>) ---
AUTH_DEV=
