{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "*/.env": "deny",
      "*/.env.*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "**/*.pem": "deny",
      "*.key": "deny",
      "**/*.key": "deny",
      "firebase-admin*.json": "deny",
      "*firebase-admin*.json": "deny",
      "**/firebase-admin*.json": "deny",
      "C:\\Users\\estiven\\.secretos-qr\\**": "deny",
      "C:/Users/estiven/.secretos-qr/**": "deny",
      ".env.example": "allow",
      "*/.env.example": "allow",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "ask",
      "src/**": "allow",
      "tests/**": "allow",
      "ia/**": "allow",
      "bruno/**": "allow",
      "scripts/**": "allow",
      "public/**": "allow",
      "package.json": "allow",
      "package-lock.json": "allow",
      "tsconfig.json": "allow",
      "next.config.ts": "allow",
      "next-env.d.ts": "allow",
      "eslint.config.mjs": "allow",
      "vitest.config.mts": "allow",
      "opencode.json": "allow",
      ".gitignore": "allow",
      ".env.example": "allow"
    },
    "bash": {
      "*": "ask",
      "npm run check": "allow",
      "npm run check *": "allow",
      "npm run build": "allow",
      "npm run build *": "allow",
      "npm test": "allow",
      "npm test *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push*": "deny",
      "rm *": "deny",
      "del *": "deny",
      "Remove-Item*": "deny",
      "curl*": "deny",
      "vercel*": "deny"
    },
    "external_directory": "deny"
  },
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*firebase-admin*.json", "effect": "deny" },
    { "action": "read", "resource": "C:/Users/estiven/.secretos-qr/*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },

    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "edit", "resource": "src/*", "effect": "allow" },
    { "action": "edit", "resource": "tests/*", "effect": "allow" },
    { "action": "edit", "resource": "ia/*", "effect": "allow" },
    { "action": "edit", "resource": "bruno/*", "effect": "allow" },
    { "action": "edit", "resource": "scripts/*", "effect": "allow" },
    { "action": "edit", "resource": "public/*", "effect": "allow" },
    { "action": "edit", "resource": "package.json", "effect": "allow" },
    { "action": "edit", "resource": "package-lock.json", "effect": "allow" },
    { "action": "edit", "resource": "tsconfig.json", "effect": "allow" },
    { "action": "edit", "resource": "next.config.ts", "effect": "allow" },
    { "action": "edit", "resource": "next-env.d.ts", "effect": "allow" },
    { "action": "edit", "resource": "eslint.config.mjs", "effect": "allow" },
    { "action": "edit", "resource": "vitest.config.mts", "effect": "allow" },
    { "action": "edit", "resource": "opencode.json", "effect": "allow" },
    { "action": "edit", "resource": ".gitignore", "effect": "allow" },
    { "action": "edit", "resource": ".env.example", "effect": "allow" },

    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "npm run check *", "effect": "allow" },
    { "action": "shell", "resource": "npm run build *", "effect": "allow" },
    { "action": "shell", "resource": "npm test *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff*", "effect": "allow" },
    { "action": "shell", "resource": "git log*", "effect": "allow" },
    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "shell", "resource": "rm *", "effect": "deny" },
    { "action": "shell", "resource": "del *", "effect": "deny" },
    { "action": "shell", "resource": "Remove-Item*", "effect": "deny" },
    { "action": "shell", "resource": "curl*", "effect": "deny" },
    { "action": "shell", "resource": "vercel*", "effect": "deny" },

    { "action": "external_directory", "resource": "*", "effect": "deny" }
  ]
}
